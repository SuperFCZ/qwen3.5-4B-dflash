#!/usr/bin/env bash
# 复制到源码之外的 dflash-env.sh，修改配置后：source /path/dflash-env.sh
if [ -z "${BASH_VERSION:-}" ]; then
    echo "请在 Bash 中使用 source 加载此文件。" >&2
    return 2 2>/dev/null || exit 2
fi
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    echo "请使用 source \"$0\"；直接执行无法修改当前终端环境。" >&2
    exit 2
fi

# 必填路径。AI_RUN_DIR 放源码之外；workspace 用户填写分配的运行目录。
export REPO_ROOT="/absolute/path/qwen3.5-4B-dflash"
export AI_RUN_DIR="/absolute/path/qwen35-run"
export MODEL_PYTHON="/absolute/path/npu-env/bin/python"
export CANN_ROOT="/absolute/path/ascend-toolkit"
export TARGET_DIR="/absolute/path/Qwen3.5-4B"
export DRAFT_DIR="/absolute/path/Qwen3.5-4B-DFlash"
export RECEIVER_ROOT="/absolute/path/qwen35-receiver"  # 仅运行已有 OM 可留空

# 常用参数
export VERIFY_GDR=chunk       # chunk / mtp
export DEVICE_ID=0
export KV_CAPACITY=2048       # prompt + 输出容量，64 的倍数
export MAX_NEW_TOKENS=128
export MAX_DRAFT_TOKENS=15
export QUANT_MODE=disable     # 原生推理：disable=FP16，enable=W8A8
export PROMPT='请用通俗的中文解释什么是机器学习。'

# 已有部署请填写实际路径；新部署可以沿用这些默认路径。
export QUANT_CONFIG="$AI_RUN_DIR/qwen35-w8a8.yaml"
export CPP_RUNNER="$AI_RUN_DIR/build/cpp/qwen35_dflash_acl_runner"
export CHUNK_DEPLOYMENT_MANIFEST="$AI_RUN_DIR/artifacts-chunk/deployment-manifest.json"
export MTP_DEPLOYMENT_MANIFEST="$AI_RUN_DIR/artifacts-mtp/deployment-manifest.json"
export RUNNER_CONFIG="$AI_RUN_DIR/runner.json"
export ATC_BIN="$CANN_ROOT/bin/atc"
export SOC_VERSION=Ascend310P3 # 改成实际 SoC
export MSPROF_BIN="$CANN_ROOT/tools/profiler/bin/msprof"
export SAVED_BATCH=""         # 查看旧结果时填写 runner-batch.json 路径

# 以下无需修改。
source "$REPO_ROOT/tools/activate_env.sh"
