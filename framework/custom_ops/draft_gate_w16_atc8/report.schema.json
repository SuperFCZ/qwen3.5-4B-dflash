    {"if":{"properties":{"phase":{"const":"compare"}}},"then":{"properties":{"status":{"enum":["BLOCKED","W16_NO_GO","W16_COMPARE_PASS"]}},"allOf":[{"if":{"properties":{"status":{"enum":["W16_COMPARE_PASS","W16_NO_GO"]}}},"then":{"required":["comparison"],"properties":{"error":{"type":"null"},"integrity_error":{"type":"null"},"device_execution":{"const":"NOT_RUN"},"atc":{"const":"NOT_RUN"},"benchmark":{"const":"NOT_RUN"}}}}]}},
    {"if":{"properties":{"phase":{"const":"five-c16-atc"}}},"then":{"properties":{"status":{"enum":["BLOCKED","W16_FIVE_C16_ATC_PASS"]}},"allOf":[{"if":{"properties":{"status":{"enum":["W16_FIVE_C16_ATC_PASS","W16_NO_GO"]}}},"then":{"required":["models","captures","baseline_images"],"properties":{"error":{"type":"null"},"integrity_error":{"type":"null"},"device_execution":{"const":"NOT_RUN"},"atc":{"const":"FROZEN_AIR_COMPILED_AND_EMBEDDED_ELF_CAPTURED"},"benchmark":{"const":"NOT_RUN"}}}}]}},
    {"if":{"properties":{"phase":{"const":"five-c16-static"}}},"then":{"properties":{"status":{"enum":["BLOCKED","BLOCKED_STATIC_ADMISSION","NO_TESTABLE_OVERLAP","W16_FIVE_C16_STATIC_PASS"]}},"allOf":[{"if":{"properties":{"status":{"enum":["W16_FIVE_C16_STATIC_PASS","W16_NO_GO"]}}},"then":{"required":["proofs","review_commit"],"properties":{"error":{"type":"null"},"integrity_error":{"type":"null"},"device_execution":{"const":"NOT_RUN"},"atc":{"const":"NOT_RUN"},"benchmark":{"const":"NOT_RUN"},"proofs":{"type":"object","minProperties":1}}}}]}},
    {"if":{"properties":{"phase":{"const":"five-c16-smoke"}}},"then":{"properties":{"status":{"enum":["BLOCKED","W16_FIVE_C16_SMOKE_PASS"]}},"allOf":[{"if":{"properties":{"status":{"enum":["W16_FIVE_C16_SMOKE_PASS","W16_NO_GO"]}}},"then":{"required":["runs","cross_variant_output_sha256"],"properties":{"error":{"type":"null"},"integrity_error":{"type":"null"},"device_execution":{"const":"COMPLETED"},"atc":{"const":"NOT_RUN"},"benchmark":{"const":"NOT_RUN"},"runs":{"type":"array","minItems":1,"items":{"type":"object","required":["mode","layer","gear","runner","om","opp_root","atc_plan","gate","maps","outputs","bit_mismatches","validation","launch_authorized"],"properties":{"launch_authorized":{"const":true},"bit_mismatches":{"const":0},"profiled":{"const":false},"gate":{"type":"object","required":["pid","child_pid","fd","endpoint","runner","control_token","live_pre_maps_equal"]}}}}}}}]}},
    {"if":{"properties":{"phase":{"const":"five-c16-benchmark"}}},"then":{"properties":{"status":{"enum":["BLOCKED","W16_NO_GO","W16_FIVE_C16_BENCHMARK_PASS"]}},"allOf":[{"if":{"properties":{"status":{"enum":["W16_FIVE_C16_BENCHMARK_PASS","W16_NO_GO"]}}},"then":{"required":["runs","statistics","cross_variant_output_sha256"],"properties":{"error":{"type":"null"},"integrity_error":{"type":"null"},"device_execution":{"const":"COMPLETED"},"atc":{"const":"NOT_RUN"},"benchmark":{"const":"FRESH_RESIDENT_EXECUTE_SYNC_MEASURED"},"runs":{"type":"array","minItems":1,"items":{"type":"object","required":["mode","layer","gear","runner","om","opp_root","atc_plan","gate","maps","outputs","bit_mismatches","validation","launch_authorized"],"properties":{"launch_authorized":{"const":true},"bit_mismatches":{"const":0},"profiled":{"const":false},"gate":{"type":"object","required":["pid","child_pid","fd","endpoint","runner","control_token","live_pre_maps_equal"]}}}}}}}]}},
