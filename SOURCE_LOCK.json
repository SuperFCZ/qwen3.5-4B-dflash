        128,
        256,
        512,
        1024
      ],
      "routes": [
        "chunk",
        "mtp"
      ],
      "policy": "preflight both complete bundles and all prompt budgets before device jobs; independent paired 3+10 prompt suites per length/route; always-on speculation; explicit allow-output-differences; warmups/startup excluded from measured graph-call and model-loop statistics",
      "long_context_prompts": {
        "file": "config/prompts_long_1k.json",
        "count": 4,
        "locked_tokenizer_chat_input_tokens": [
          983,
          998,
          1001,
          1008
        ],
        "policy": "full prompts, no truncation or repetition padding; runtime records actual input_tokens and checks input plus output against capacity"
      }
    },
    "common_reuse": "same-directory two-route bundle has five OM files; export-air --reuse-common-from reuses validated prefill/decode/draft AIR payloads and OMs; only Verify exported/compiled; separate directories may use hardlinks"
  }
