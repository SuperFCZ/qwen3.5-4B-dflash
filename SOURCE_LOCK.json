    "supported_abis": [
      "qwen35-dflash-chunk-v4",
      "qwen35-dflash-mtp-v2",
      "qwen35-dflash-chunk-v3",
      "qwen35-dflash-mtp-v1"
    ],
    "default_verify_gdr": "chunk",
    "mtp_reference": {
      "repository": "day8reak/qwen3.5-4B-dflash",
      "branch": "framework/quant-air-om",
      "commit": "631c86fc0c4e053817f0786ab8067b5565638d50"
    },
    "verification_policy": "explicit verify_gdr chooses Verify; ordinary/Chunk/MTP all preserve FP32 recurrent cache; conv/KV and Draft remain FP16; Torch-NPU selects route without OM compilation",
    "length_benchmark": {
      "entry": "tools/benchmark_gdr_lengths.py",
      "default_lengths": [
        32,
        64,
        128,
        256,
        512,
        1024
      ],
      "routes": [
        "chunk",
        "mtp"
      ],
      "policy": "preflight selected bundles, input+output budgets and repeat counts; independent paired suites default to 1 warmup + 3 measured generations; configurable counts saved and checked against requests; always-on speculation; explicit allow-output-differences; batch-owned fake_acl identity; phase and graph times exclude warmups/startup/reset; mixed suites also aggregate short/long groups",
      "long_context_prompts": {
        "file": "config/prompts_long_1k.json",
        "count": 12,
        "locked_tokenizer_chat_input_tokens": [
          983,
          998,
          1001,
          1008,
          978,
          984,
          1004,
          1024,
          980,
          1022,
          1007,
          987
        ],
        "policy": "six Chinese-language tasks (including English-to-Chinese translation) and six English-language tasks; complete prompts without truncation or repetition padding; runtime records actual input_tokens and checks input plus output against capacity",
        "language_distribution": {
          "zh_tasks": 6,
          "en_tasks": 6
        }
      },
      "default_verify_gdr": "both",
      "selection": "--prompt-group all|short|long; --verify-gdr chunk|mtp|both; repeatable --prompt-id; one or more --lengths; --warmup and --repetitions; only selected manifests are required and read",
      "default_prompt_group": "all",
      "default_prompt_count": 20,
      "default_warmup": 1,
      "default_repetitions": 3,
      "timing_output": "ordinary prefill/decode and DFlash prefill/draft/verify mean synchronized ms/call and cumulative mean ms/generation; full prefill/decode phases separately include orchestration and context-building Draft; timings in terminal, Markdown, JSON and per-prompt CSV"
    },
    "common_reuse": "same-directory two-route bundle has five OM files; export-air --reuse-common-from reuses validated prefill/decode/draft AIR payloads and OMs; only Verify exported/compiled; separate directories may use hardlinks",
    "draft_execution": {
      "context_rows": 16,
      "context_gears": [
        16,
        64
      ],
      "prefill": "single_draft16_64_gears; ceil(input_tokens/64)-1 discarded-proposal preparation calls; final block in first useful Draft; no second Draft OM",
      "selection": "valid_rows > 16 selects gear 64; otherwise gear 16; one symbolic features axis and CANN finite dynamic_dims",
      "validation": "CPU equivalence, symbolic graph capture and fake ACL scheduling only; real TorchAir/ATC and Ascend310P measurements pending",
      "memory": "reuse 64-row feature buffer and current/next KV banks; one mandatory CANN control buffer; physical gear weight/workspace/peak pending"
    },
    "om_io_binding": {
      "runner_version": "1.11.0",
      "policy": "prebound_ping_pong",
      "scope": "prebound ping-pong descriptors for existing state banks; Draft CANN gear-control input shared between descriptor sets",
      "validation": "Host fake-ACL equivalence only; real Ascend310P timing pending"
    }
  }
